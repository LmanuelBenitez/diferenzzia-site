# Spotify Web API credentials (Netlify function: spotify-top-tracks)
# Create an app at https://developer.spotify.com/dashboard and copy these.
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
# The Spotify artist ID for Diferenzzia (from the artist's share URL).
SPOTIFY_ARTIST_ID=your_artist_id_here

# Optional: forward booking submissions to a webhook (Slack / Zapier / Make).
# BOOKING_WEBHOOK_URL=https://hooks.example.com/your-webhook
